# Copy to .env (dev), .env.staging or .env.production and fill in real values.
# Never commit the filled-in files — only this template is tracked.

NODE_ENV=development
PORT=4000

# MongoDB connection string (use a separate database per environment)
DATABASE_URL=

# Signs login tokens. Must be long and random, and different per environment.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Production refuses to start if this is missing, shorter than 32 chars, or a
# known placeholder.
JWT_SECRET=

# AI features
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLAMA_CLOUD_API_KEY=

# Google Drive (resume storage)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Set to "true" when the resume worker runs as its own process (npm run worker)
DISABLE_IN_PROCESS_WORKER=

# Optional: password for the admin user created by `npm run seed` on a fresh
# database. If unset, a random one is generated and printed once.
SEED_ADMIN_PASSWORD=

# Set to "true" only if public self-sign-up (POST /api/auth/register) is wanted.
ALLOW_PUBLIC_REGISTRATION=

# Behind nginx / a load balancer: number of proxy hops to trust (e.g. 1), so
# the login rate limiter sees real client IPs.
TRUST_PROXY=

# Set to "true" to serve Swagger docs (/api-docs) in production.
ENABLE_SWAGGER=
