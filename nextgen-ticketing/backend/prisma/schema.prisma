generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==================== AUTH & USERS ====================

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  password      String
  fullname      String
  image         String?
  title         String?
  workNumber    String?
  mobileNumber  String?

  roleId        String    @db.ObjectId
  role          Role      @relation(fields: [roleId], references: [id])

  groupIds      String[]  @db.ObjectId
  groups        Group[]   @relation(fields: [groupIds], references: [id])

  teamIds       String[]  @db.ObjectId
  teams         Team[]    @relation(fields: [teamIds], references: [id])

  ownedTickets    Ticket[] @relation("TicketOwner")
  assignedTickets Ticket[] @relation("TicketAssignee")

  comments      Comment[]
  history       History[]

  chatMessages  ChatMessage[]
  chatRoomIds   String[]      @db.ObjectId
  chatRooms     ChatRoom[]    @relation(fields: [chatRoomIds], references: [id])

  notifications Notification[]
  requests      UserRequest[]

  timesheetEntries   TimesheetEntry[] @relation("UserTimesheets")
  approvedTimesheets TimesheetEntry[] @relation("TimesheetApprover")

  scheduledInterviews  Interview[]          @relation("InterviewScheduler")
  interviewPanels      InterviewPanel[]
  interviewFeedbacks   InterviewFeedback[]  @relation("InterviewFeedbackGiver")

  lastOnline    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deleted       Boolean   @default(false)
}

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  isAdmin     Boolean  @default(false)
  isAgent     Boolean  @default(false)
  isCustomer  Boolean  @default(false)
  isEmployee  Boolean  @default(false)
  isHR        Boolean  @default(false)
  permissions Json
  users       User[]
}

// ==================== TICKETS ====================

model Ticket {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  uid         Int      @unique
  subject     String
  issue       String

  statusId    String   @db.ObjectId
  status      Status   @relation(fields: [statusId], references: [id])

  priorityId  String   @db.ObjectId
  priority    Priority @relation(fields: [priorityId], references: [id])

  typeId      String   @db.ObjectId
  type        Type     @relation(fields: [typeId], references: [id])

  ownerId     String   @db.ObjectId
  owner       User     @relation("TicketOwner", fields: [ownerId], references: [id])

  assigneeId  String?  @db.ObjectId
  assignee    User?    @relation("TicketAssignee", fields: [assigneeId], references: [id])

  groupId     String?  @db.ObjectId
  group       Group?   @relation(fields: [groupId], references: [id])

  tags        String[]
  comments    Comment[]
  history     History[]
  timesheetTasks TimesheetTask[]

  dueDate     DateTime?
  closedAt    DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deleted     Boolean  @default(false)
}

model Status {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  color       String   @default("#000000")
  order       Int      @default(0)
  isResolved  Boolean  @default(false)
  tickets     Ticket[]
}

model Priority {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  color       String   @default("#000000")
  order       Int      @default(0)
  tickets     Ticket[]
}

model Type {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  tickets     Ticket[]
}

model Comment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  comment     String
  isNote      Boolean  @default(false)
  authorId    String   @db.ObjectId
  author      User     @relation(fields: [authorId], references: [id])
  ticketId    String   @db.ObjectId
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
  createdAt   DateTime @default(now())
}

model History {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  action      String
  description String
  actorId     String   @db.ObjectId
  actor       User     @relation(fields: [actorId], references: [id])
  ticketId    String   @db.ObjectId
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
  createdAt   DateTime @default(now())
}

// ==================== ORGANIZATION ====================

model Group {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  isPublic    Boolean  @default(false)
  memberIds   String[] @db.ObjectId
  members     User[]   @relation(fields: [memberIds], references: [id])
  tickets     Ticket[]
  timesheetTasks TimesheetTask[]

  departmentIds String[] @db.ObjectId
  departments   Department[] @relation(fields: [departmentIds], references: [id])

  createdAt   DateTime @default(now())
}

model Team {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  memberIds   String[] @db.ObjectId
  members     User[]   @relation(fields: [memberIds], references: [id])

  departmentIds String[] @db.ObjectId
  departments   Department[] @relation(fields: [departmentIds], references: [id])

  createdAt   DateTime @default(now())
}

model Department {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  allGroups   Boolean  @default(false)

  teamIds     String[] @db.ObjectId
  teams       Team[]   @relation(fields: [teamIds], references: [id])

  groupIds    String[] @db.ObjectId
  groups      Group[]  @relation(fields: [groupIds], references: [id])

  createdAt   DateTime @default(now())
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  message     String
  type        String   @default("info")
  unread      Boolean  @default(true)
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  data        Json?
  createdAt   DateTime @default(now())
}

model Notice {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  message     String
  color       String   @default("#7c3aed")
  fontColor   String   @default("#ffffff")
  active      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== CHAT ====================

model ChatRoom {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String?
  isGroup     Boolean  @default(false)
  memberIds   String[] @db.ObjectId
  members     User[]   @relation(fields: [memberIds], references: [id])
  messages    ChatMessage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatMessage {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  body        String
  senderId    String   @db.ObjectId
  sender      User     @relation(fields: [senderId], references: [id])
  roomId      String   @db.ObjectId
  room        ChatRoom @relation(fields: [roomId], references: [id])
  createdAt   DateTime @default(now())
}

// ==================== REQUESTS ====================

model UserRequest {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  type        String   // e.g., "FORGOT_PASSWORD"
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  message     String?
  userId      String?  @db.ObjectId
  user        User?    @relation(fields: [userId], references: [id])
  email       String?
  data        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
// ==================== TIMESHEET ====================

model TimesheetEntry {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  date        DateTime
  totalHours  Float    @default(0) // Manually entered by user
  notes       String?
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  
  userId      String   @db.ObjectId
  user        User     @relation("UserTimesheets", fields: [userId], references: [id])
  
  approvedById String? @db.ObjectId
  approvedBy   User?   @relation("TimesheetApprover", fields: [approvedById], references: [id])
  
  tasks       TimesheetTask[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([userId, date])
}

model TimesheetTask {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  description   String
  hours         Float
  
  projectId     String?  @db.ObjectId
  project       Group?   @relation(fields: [projectId], references: [id])
  
  ticketId      String?  @db.ObjectId
  ticket        Ticket?  @relation(fields: [ticketId], references: [id])
  
  entryId       String   @db.ObjectId
  entry         TimesheetEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
}

// ==================== INTERVIEWS ====================

model Candidate {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String   @unique
  phone           String?
  cnic            String?
  address         String?
  position        String
  resumeUrl       String?
  notes           String?
  objective       String?
  technicalSkills String?
  workExperience  String?
  linkedin        String?
  portfolio       String?
  github          String?
  projects        String?
  status          String   @default("Active") // Active, Hired, Rejected, On Hold
  interviews      Interview[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Interview {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  scheduledAt     DateTime
  duration        Int      @default(60)
  location        String?
  status          String   @default("Scheduled") // Scheduled, Completed, Cancelled
  notes           String?

  candidateId     String   @db.ObjectId
  candidate       Candidate @relation(fields: [candidateId], references: [id])

  scheduledById   String   @db.ObjectId
  scheduledBy     User     @relation("InterviewScheduler", fields: [scheduledById], references: [id])

  panelMembers    InterviewPanel[]
  feedbacks       InterviewFeedback[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model InterviewPanel {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  interviewId   String    @db.ObjectId
  interview     Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  userId        String    @db.ObjectId
  user          User      @relation(fields: [userId], references: [id])

  @@unique([interviewId, userId])
}

model InterviewFeedback {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  interviewId          String    @db.ObjectId
  interview            Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  interviewerId        String    @db.ObjectId
  interviewer          User      @relation("InterviewFeedbackGiver", fields: [interviewerId], references: [id])

  communicationRating  Int
  technicalRating      Int
  leadershipRating     Int
  overallRating        Float
  comments             String?
  recommendation       String   @default("Neutral") // Strong Hire, Hire, Neutral, No Hire, Strong No Hire

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([interviewId, interviewerId])
}
