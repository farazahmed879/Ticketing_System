generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ==================== AUTH & USERS ====================

model User {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  email        String  @unique
  password     String
  fullname     String
  username     String?
  companyEmail String?
  image        String?
  title        String?
  workNumber   String?
  mobileNumber String?

  primaryContact     String?
  secondaryContact   String?
  cnic               String?
  linkedInUrl        String?
  gitUrl             String?
  address            String?
  emergencyContact   String?
  primaryResumeUrl   String?
  jpPatternResumeUrl String?
  nationality        String?
  location           String?
  employeeType       String? @default("Onsite") // Onsite, Remote
  branch             String?
  leaves             Float   @default(20)

  roleId String @db.ObjectId
  role   Role   @relation(fields: [roleId], references: [id])

  groupIds String[] @db.ObjectId
  groups   Group[]  @relation(fields: [groupIds], references: [id])

  teamIds String[] @db.ObjectId
  teams   Team[]   @relation(fields: [teamIds], references: [id])

  ownedTickets      Ticket[] @relation("TicketOwner")
  assignedTickets   Ticket[] @relation("TicketAssignee")
  assignedQATickets Ticket[] @relation("TicketQA")

  comments Comment[]
  history  History[]

  chatMessages ChatMessage[]
  chatRoomIds  String[]      @db.ObjectId
  chatRooms    ChatRoom[]    @relation(fields: [chatRoomIds], references: [id])

  notifications Notification[]
  requests      UserRequest[]

  timesheetEntries   TimesheetEntry[] @relation("UserTimesheets")

  announcements Announcement[]
  createdCandidates Candidate[] @relation("CandidateCreator")

  scheduledInterviews Interview[]         @relation("InterviewScheduler")
  interviewPanels     InterviewPanel[]
  interviewFeedbacks  InterviewFeedback[] @relation("InterviewFeedbackGiver")

  projectIds String[]  @db.ObjectId
  projects   Project[] @relation(fields: [projectIds], references: [id])

  ledTeams        Team[]    @relation("TeamLead")
  managedProjects Project[] @relation("ProjectManager")
  lastOnline      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deleted         Boolean   @default(false)
  isLead          Boolean   @default(false)
}

model Role {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String  @unique
  description String?
  roleType    String  @default("employee")
  permissions Json
  users       User[]
  deleted     Boolean @default(false)
}

// ==================== TICKETS ====================

model Ticket {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  uid     Int    @unique
  subject String
  issue   String

  statusId   String @db.ObjectId
  priorityId String @db.ObjectId

  typeId String

  ownerId String @db.ObjectId
  owner   User   @relation("TicketOwner", fields: [ownerId], references: [id])

  assigneeId String? @db.ObjectId
  assignee   User?   @relation("TicketAssignee", fields: [assigneeId], references: [id])

  qaId String? @db.ObjectId
  qa   User?   @relation("TicketQA", fields: [qaId], references: [id])

  groupId String? @db.ObjectId
  group   Group?  @relation(fields: [groupId], references: [id])

  projectId String?  @db.ObjectId
  project   Project? @relation(fields: [projectId], references: [id])

  tags           String[]
  attachments    String[]
  comments       Comment[]
  history        History[]
  timesheetTasks TimesheetTask[]

  dueDate  DateTime?
  closedAt DateTime?

  // Sticky flag: set true the first time a ticket is moved to "Returned"
  // (Failed). Stays true even after the ticket moves to another status, so the
  // detail views can show that it was failed at some point.
  wasFailed Boolean @default(false)

  interviewId String?    @db.ObjectId
  interview   Interview? @relation(fields: [interviewId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
}

model Comment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  comment     String
  isNote      Boolean  @default(false)
  attachments String[]
  authorId    String   @db.ObjectId
  author      User     @relation(fields: [authorId], references: [id])
  ticketId    String   @db.ObjectId
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
  createdAt   DateTime @default(now())
}

model History {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  action      String
  description String
  actorId     String   @db.ObjectId
  actor       User     @relation(fields: [actorId], references: [id])
  ticketId    String   @db.ObjectId
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
  createdAt   DateTime @default(now())
}

// ==================== ORGANIZATION ====================

model Group {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  isPublic  Boolean  @default(false)
  memberIds String[] @db.ObjectId
  members   User[]   @relation(fields: [memberIds], references: [id])
  tickets   Ticket[]
  createdAt DateTime @default(now())
  deleted   Boolean  @default(false)
}

model Team {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  memberIds   String[] @db.ObjectId
  members     User[]   @relation(fields: [memberIds], references: [id])

  departmentId String?     @db.ObjectId
  department   Department? @relation(fields: [departmentId], references: [id])

  teamLeadId String? @db.ObjectId
  teamLead   User?   @relation("TeamLead", fields: [teamLeadId], references: [id])

  projectIds String[]  @db.ObjectId
  projects   Project[] @relation(fields: [projectIds], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
}

model Department {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String  @unique
  description String?

  teams    Team[]
  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
}

model Project {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String  @unique
  description String?
  status      String  @default("Active") // Active, On Hold, Completed, Cancelled

  departmentId String?     @db.ObjectId
  department   Department? @relation(fields: [departmentId], references: [id])

  clientIds String[] @db.ObjectId
  clients   User[]   @relation(fields: [clientIds], references: [id])

  managerId String? @db.ObjectId
  manager   User?   @relation("ProjectManager", fields: [managerId], references: [id])

  teamIds String[] @db.ObjectId
  teams   Team[]   @relation(fields: [teamIds], references: [id])

  tickets Ticket[]

  timesheetTasks TimesheetTask[]

  announcements Announcement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  message   String
  type      String   @default("info")
  unread    Boolean  @default(true)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  data      Json?
  createdAt DateTime @default(now())
}

model Notice {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  message   String
  color     String   @default("#7c3aed")
  fontColor String   @default("#ffffff")
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
}

model Announcement {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  date         DateTime
  type         String   @default("event") // event, important, info
  shouldPopout Boolean  @default(false)

  projectId String?  @db.ObjectId
  project   Project? @relation(fields: [projectId], references: [id])

  authorId  String   @db.ObjectId
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
}

// ==================== CHAT ====================

model ChatRoom {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        String?
  isGroup     Boolean       @default(false)
  memberIds   String[]      @db.ObjectId
  hiddenByIds String[]      @db.ObjectId
  members     User[]        @relation(fields: [memberIds], references: [id])
  messages    ChatMessage[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ChatMessage {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  body        String   @default("")
  attachments String[]
  senderId    String   @db.ObjectId
  sender      User     @relation(fields: [senderId], references: [id])
  roomId      String   @db.ObjectId
  room        ChatRoom @relation(fields: [roomId], references: [id])
  replyToId   String?  @db.ObjectId
  replyTo     ChatMessage? @relation("ReplyTo", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies     ChatMessage[] @relation("ReplyTo")
  createdAt   DateTime @default(now())
}

// ==================== REQUESTS ====================

model UserRequest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  type      String // e.g., "FORGOT_PASSWORD"
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  message   String?
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])
  email     String?
  data      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
}

// ==================== TIMESHEET ====================

model TimesheetEntry {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  date       DateTime
  totalHours Float    @default(0) // Manually entered by user
  notes      String?
  managerApproved String? @default("PENDING") 
  hrApproved      String? @default("PENDING")

  userId String @db.ObjectId
  user   User   @relation("UserTimesheets", fields: [userId], references: [id])

  tasks TimesheetTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model TimesheetTask {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  description String
  hours       Float

  projectId String?  @db.ObjectId
  project   Project? @relation(fields: [projectId], references: [id])

  ticketId String? @db.ObjectId
  ticket   Ticket? @relation(fields: [ticketId], references: [id])

  entryId String         @db.ObjectId
  entry   TimesheetEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ==================== INTERVIEWS ====================

model Candidate {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String      @unique
  phone           String?
  cnic            String?
  address         String?
  isConverted     Boolean     @default(false)
  position        String
  resumeUrl       String?
  notes           String?
  objective       String?
  technicalSkills String?
  workExperience  String?
  // AI search enrichment: populated by the LLM extraction step (write-time).
  skills          String[]    // normalized skill tags, e.g. ["python", "fastapi"]
  yearsExperience Float?      // total years of experience parsed from workExperience
  skillEmbedding  Float[]     // BGE vector of the profile text (semantic search)
  linkedin        String?
  portfolio       String?
  github          String?
  projects        String?
  observingSkills String?
  metaTags        String?     // comma-separated tags, e.g. "Referred,Hot Lead,Remote"
  status          String      @default("Active") // Active, Hired, Rejected, On Hold
  dob             DateTime?
  nationality     String?
  city            String?
  immediateJoiner Boolean     @default(false)

  createdById     String?     @db.ObjectId
  createdBy       User?       @relation("CandidateCreator", fields: [createdById], references: [id])

  interviews      Interview[]
  notesLog        CandidateNote[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deleted         Boolean     @default(false)
}

// A single attributed note on a candidate. authorName/authorRole are snapshots
// taken at write time so attribution stays correct even if the user or their
// role later changes or is removed.
model CandidateNote {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  content     String
  authorId    String?   @db.ObjectId
  authorName  String
  authorRole  String?
  candidateId String    @db.ObjectId
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  createdAt   DateTime  @default(now())
}

model Interview {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  scheduledAt DateTime
  duration    Int      @default(60)
  location    String?
  status      String   @default("Scheduled") // Scheduled, Completed, Cancelled
  notes       String?

  candidateId String    @db.ObjectId
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  scheduledById String @db.ObjectId
  scheduledBy   User   @relation("InterviewScheduler", fields: [scheduledById], references: [id])

  panelMembers InterviewPanel[]
  feedbacks    InterviewFeedback[]
  tickets      Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)
}

model InterviewPanel {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  interviewId String    @db.ObjectId
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  userId      String    @db.ObjectId
  user        User      @relation(fields: [userId], references: [id])

  @@unique([interviewId, userId])
}

model InterviewFeedback {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  interviewId String    @db.ObjectId
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  interviewerId String @db.ObjectId
  interviewer   User   @relation("InterviewFeedbackGiver", fields: [interviewerId], references: [id])

  communicationRating Int
  technicalRating     Int
  leadershipRating    Int
  overallRating       Float
  comments            String?
  recommendation      String  @default("Neutral") // Strong Hire, Hire, Neutral, No Hire, Strong No Hire

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([interviewId, interviewerId])
}
